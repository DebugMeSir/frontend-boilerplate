  "dependencies": {
    "autoprefixer": "^10.4.12",
    "ejs": "^3.1.8",
    "nodemon": "^2.0.20",
    "postcss": "^8.4.17",
    "postcss-cli": "^10.0.0",
    "purgecss": "^5.0.0",
    "sass": "^1.55.0",
    "tailwind": "^4.0.0"
  }
}
