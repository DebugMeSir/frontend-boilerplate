{
  "name": "html",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "nodemon": "nodemon ejs.config.js -e js,ejs,json,css,scss",
    "sass": "sass --watch ./project/css/main.scss style.css",
    "tailwind": "npx tailwindcss -i ./project/css/vendor/tailwind/input.css -o ./project/css/vendor/tailwind/output.css --watch",
    "purge": "purgecss --css style.css --content index.html --output style-purged.css",
    "autoprefixer": "npx postcss style-purged.css --use autoprefixer >  style-prefix.css "
  },
